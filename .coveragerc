# The coverage gate (CI: --cov-fail-under) measures the code that serves users: API, MCP tools, agents, sandbox,
# simulators, graders, registry. Build-time tools that need the network or aerial imagery run offline by an operator
# and are exercised by `make data`, not by the test suite:
[run]
source = keystone
omit =
    keystone/pipeline.py
    keystone/cli.py
    keystone/data/*
    keystone/demo/build_assets.py
    keystone/models/site_score.py
# Not reached by tests either, by design: the training paths inside runtime modules (market_gap.load/fit/main,
# homekeeper.build_portfolio/run, cnn training) read raw HMDA files and image chips that are not in git. The CI gate
# (75%) is the measured floor of everything else, so coverage cannot silently regress.
