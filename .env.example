# Copy to .env (never commit it). Every variable is optional: without a key, agents run on the offline scripted policy.
ANTHROPIC_API_KEY=
# Turns on the demo sign-in (maria@habitat-oc.demo / keys-to-100). The Mac app sets this itself.
KEYSTONE_DEMO_LOGIN=1
# Where accounts, agent runs, lessons and skills are stored. Defaults to ./artifacts.
KEYSTONE_STATE_DIR=
# Region file under keystone/regions/. Defaults to orange_county_ca.
KEYSTONE_REGION=orange_county_ca
# Bearer token that protects the agent and MCP endpoints on a public server.
KEYSTONE_API_TOKEN=
# Let remote visitors' scenario missions use Claude (costs money). Off by default.
KEYSTONE_SCENARIO_CLAUDE=
